# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Binary files - prevent text diffs, line ending modification, or corruption
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary

# Documentation and configuration
*.md text
*.txt text
*.yml text
*.yaml text
*.sh text eol=lf
